# @ar.io/sdk is pinned to a prerelease (4.1.0-alpha.6) that the ArNS Solana
# features require, but @ar.io/wayfinder-core declares peerOptional
# @ar.io/sdk ">=4.0.0" — and npm's semver rejects a prerelease against a stable
# range, so strict peer resolution errors even on an optional peer. This lets
# plain `npm install` / `npm ci` succeed without the flag. Remove once a stable
# @ar.io/sdk 4.1.x ships (only 4.0.x stable + 4.1.0-alpha.x exist today).
legacy-peer-deps=true
